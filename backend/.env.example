# SaarthiText backend configuration.
# All secrets and environment-specific values are loaded from environment
# variables (optionally from a local .env file). Nothing is hardcoded.

# ---- Application ----
APP_NAME=SaarthiText
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security ----
# Generate a strong value, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Database ----
# Default is a local SQLite file (zero setup). To use PostgreSQL instead,
# install psycopg2-binary and set, for example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/saarthitext
DATABASE_URL=sqlite:///./saarthitext.db

# ---- LLM provider ----
# Supported: anthropic | openai | gemini | openai_compatible
# Supported: anthropic | openai | openai_compatible | gemini | openrouter
LLM_PROVIDER=gemini
# Current Gemini model on the free tier, suitable for simplification,
# structured fact extraction and verification. Any valid model ID works;
# override here without touching code.
LLM_MODEL=gemini-3.8-flash
LLM_MAX_TOKENS=4000

# Anthropic (default provider)
ANTHROPIC_API_KEY=

# OpenAI / OpenAI-compatible (optional)
OPENAI_API_KEY=
# For OpenAI-compatible servers (Ollama, LM Studio, Groq, ...), set the base URL:
OPENAI_BASE_URL=

# OpenRouter (optional OpenAI-compatible provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# To use OpenRouter, set LLM_PROVIDER=openrouter and choose a model, for example:
# LLM_MODEL=qwen/qwen3.8-27b:free

# Google Gemini (optional)
GOOGLE_API_KEY=

# ---- Uploads ----
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads
